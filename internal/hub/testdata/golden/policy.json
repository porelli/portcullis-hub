{
  "version": 7,
  "methods": [
    "passkey_device",
    "passkey_synced",
    "security_key",
    "yubikey_cert"
  ],
  "templates": {
    "standard": {
      "op": "any",
      "items": [
        {
          "op": "any",
          "items": [
            "passkey_synced",
            "passkey_device",
            "security_key"
          ]
        },
        {
          "op": "any",
          "items": [
            "yubikey_cert"
          ]
        }
      ]
    },
    "strong": {
      "op": "any",
      "items": [
        "security_key",
        "yubikey_cert"
      ]
    }
  },
  "default": "standard",
  "hosts": {},
  "core": {
    "directory.example.org": "standard",
    "example.org": "standard",
    "hub.example.org": "strong",
    "metrics.example.org": "standard",
    "people.example.org": "strong",
    "traefik.example.org": "standard"
  },
  "people": {},
  "add_stronger": false,
  "extra_domains": [],
  "groups": {
    "grafana.example.org": "users_grafana"
  },
  "path_groups": {
    "grafana.example.org": [
      {
        "prefix": "/admin",
        "group": "admin_grafana"
      }
    ]
  },
  "public_paths": {},
  "expiring": [],
  "vpn": {
    "hosts": {},
    "server_mode": false,
    "admin_only": false,
    "public_enrol": true,
    "devices_file": "vpn.json"
  }
}
